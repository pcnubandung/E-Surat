:{$PORT:3000}

root * /app/dist

file_server

@notStatic {
	not path /assets/* /logo-org.png /favicon.svg *.png *.jpg *.ico *.svg *.woff2 *.webmanifest
}

header @notStatic Cache-Control "no-cache, no-store, must-revalidate"
header /assets/* Cache-Control "public, max-age=31536000, immutable"

try_files {path} /index.html
